  "SUBQUERY_2_CORRELATED": {
    "sql": "\n        SELECT \n            s.id AS stock_id,\n            i.name AS item_name,\n            l.name AS lab_name,\n            s.good AS available_units\n        FROM stock s\n        INNER JOIN items i ON i.id = s.item_id\n        INNER JOIN labs l ON l.id = s.lab_id\n        WHERE s.good < (\n            SELECT AVG(s2.good) \n            FROM stock s2 \n            WHERE s2.item_id = s.item_id\n        )\n        ORDER BY s.good ASC\n        LIMIT 5;\n        ",
    "columns": [
      "stock_id",
      "item_name",
      "lab_name",
      "available_units"
    ],

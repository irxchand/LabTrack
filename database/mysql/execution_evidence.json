  "JOIN_1_INNER_JOIN": {
    "sql": "\n        SELECT \n            rl.id AS line_id,\n            r.id AS request_id,\n            r.state AS request_state,\n            i.name AS item_name,\n            l.name AS lab_name,\n            rl.quantity\n        FROM request_lines rl\n        INNER JOIN requests r ON r.id = rl.request_id\n        INNER JOIN items i ON i.id = rl.item_id\n        INNER JOIN labs l ON l.id = rl.lab_id\n        ORDER BY rl.id ASC\n        LIMIT 5;\n        ",
    "columns": [
      "line_id",

  "SUBQUERY_1_NESTED_IN": {
    "sql": "\n        SELECT id, name, lab_code, branch\n        FROM labs\n        WHERE id IN (\n            SELECT DISTINCT rl.lab_id \n            FROM request_lines rl\n            INNER JOIN requests r ON r.id = rl.request_id\n            WHERE r.state IN ('ISSUED', 'IN_USE')\n        )\n        ORDER BY id ASC;\n        ",

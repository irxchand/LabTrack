  "JOIN_2_LEFT_OUTER_JOIN": {
    "sql": "\n        SELECT \n            l.id AS lab_id,\n            l.name AS lab_name,\n            COUNT(s.item_id) AS stocked_item_count,\n            COALESCE(SUM(s.good), 0) AS total_good_units\n        FROM labs l\n        LEFT JOIN stock s ON s.lab_id = l.id\n        GROUP BY l.id, l.name\n        ORDER BY stocked_item_count DESC\n        LIMIT 5;\n        ",
    "columns": [
